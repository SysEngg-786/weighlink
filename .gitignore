# ==============================================================================
# .gitignore — weighlink
# Protocol-agnostic serial instrument bridge
# ==============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# ---- Virtual Environments ----
venv/
.venv/
env/

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Runtime Data (audit logs contain operational data — never commit) ----
data/audit_log/*.jsonl

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Environment / Secrets ----
.env
*.local
