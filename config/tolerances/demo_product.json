{
    "_comment": "weighlink/config/tolerances/demo_product.json — Demo tolerance profile",
    "_version": "1.0",

    "profile_name": "demo_product",
    "product_name": "Demo Batch Material",
    "unit": "g",

    "tolerance": {
        "min_weight": 9.5,
        "max_weight": 10.5,
        "nominal_weight": 10.0,
