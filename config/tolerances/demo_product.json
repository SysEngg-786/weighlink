    "overload_threshold": 30.0,

    "_seam_notes": {
        "future_fields": [
            "product_code (for ERP lookup)",
            "batch_size (expected count per batch)",
            "tare_weight (container weight to subtract)",
            "tolerance_class (e.g. OIML R76, NIST HB44)",
            "recalibration_interval_hours"
        ],
        "_description": "These fields are not used in v1. They are listed here to document where tomorrow's extensions attach."
    }
}
